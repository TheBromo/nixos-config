# Consume the binary cache that .github/workflows/build.yml fills, so a switch
# downloads the closure instead of compiling tree-sitter, ghostty and friends.
#
# The caches are declared once below and rendered two ways:
#
#   * the `nixCustomConf` package, meant for /etc/nix/nix.custom.conf, which
#     Determinate Nix `!include`s from its own (unmodifiable) /etc/nix/nix.conf.
#     Settings there belong to root, so the daemon trusts them unconditionally
#     and the user account stays untrusted. Install with `make nix-conf`.
#   * ~/.config/nix/nix.conf via `nix.settings`, for hosts where the user *is*
#     in trusted-users (`trustedUser = true`, the default). An untrusted client
#     cannot set trusted-public-keys at all — Nix drops it with a warning on
#     every single command — so a host covered by nix.custom.conf should pass
#     `trustedUser = false` and write nothing user-level.
{ ... }:
let
  caches = [
    {
      url = "https://thebromo.cachix.org";
      key = "thebromo.cachix.org-1:AeGbfUhNKrV+Zccnn038ZlJC0TKB8q8ijmps8LlA9M8=";
    }
    {
      url = "https://nix-community.cachix.org";
      key = "nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs=";
    }
    {
      url = "https://ghostty.cachix.org";
      key = "ghostty.cachix.org-1:QB389yTa6gTyneehvqG58y0WnHjQOqgnA+wBnpWWxns=";
    }
    {
      # Prebuilt agent binaries from the llm-agents.nix input. Only useful
      # because that input has no `nixpkgs.follows`.
      url = "https://cache.numtide.com";
      key = "niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g=";
    }
  ];

  substituters = map (c: c.url) caches;
  trustedPublicKeys = map (c: c.key) caches;
in
{
  flake.lib.nixSettingsModule =
    {
      trustedUser ? true,
    }:
    { pkgs, lib, ... }:
    {
      # Only used to validate the generated nix.conf; it is not added to
      # home.packages, so the daemon's own client stays in charge.
      nix.package = lib.mkIf trustedUser pkgs.nix;

      nix.settings = lib.mkIf trustedUser {
        extra-substituters = substituters;
        extra-trusted-public-keys = trustedPublicKeys;
      };
    };

  perSystem =
    { pkgs, ... }:
    {
      packages.nixCustomConf = pkgs.writeText "nix.custom.conf" ''
        # Generated by modules/home-manager/nix-settings in nixos-config.
        # Do not edit by hand; run `make nix-conf` to reinstall.
        #
        # Determinate Nix owns /etc/nix/nix.conf and `!include`s this file.
        # Both keys use the `extra-` prefix, so they append to whatever
        # /etc/nix/nix.conf and the installer already set.
        extra-substituters = ${builtins.concatStringsSep " " substituters}
        extra-trusted-public-keys = ${builtins.concatStringsSep " " trustedPublicKeys}
      '';
    };
}
